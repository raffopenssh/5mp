[Unit]
Description=Go web server

[Service]
Type=simple
User=exedev
Group=exedev
WorkingDirectory=/home/exedev/5mp
ExecStart=/home/exedev/5mp/server
Restart=always
RestartSec=5
Environment=HOME=/home/exedev
Environment=USER=exedev
# Secrets (ACCESS_PASSWORDS, ZENODO_TOKEN, ...) — see secrets.env.example
EnvironmentFile=-/home/exedev/5mp/secrets.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
