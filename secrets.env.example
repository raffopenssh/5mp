# 5MP secrets configuration
# Copy to secrets.env and fill in real values. secrets.env is gitignored.
# The systemd unit loads it via EnvironmentFile=; shell/python scripts source it.

# Comma-separated list of app access passwords (?pwd=... / access_pwd cookie)
ACCESS_PASSWORDS=test2026

# Patrol-data tenants: <password>:<env>, comma separated (see srv/tenant.go).
# Passwords sharing an env share patrol effort pixels, uploads, animation and
# exports. Any access password NOT listed here gets its own private, empty
# tenant -- adding a password can never silently widen access to someone
# else's patrols. Omit the whole line for a single-tenant install
# (test2026 -> test, everything else -> prod).
PASSWORD_ENVS=test2026:test

# Admin panel login
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me

# NASA FIRMS map key (https://firms.modaps.eosdis.nasa.gov/api/)
NASA_FIRMS_KEY=your-firms-map-key

# Zenodo API token for database backups (cmd/backup-zenodo)
ZENODO_TOKEN=your-zenodo-token

# Token for the exe-dev-monitor-peer01 backup mirror
BACKUP_PEER_TOKEN=your-backup-peer-token

# Global Forest Watch API key (https://data-api.globalforestwatch.org/)
GFW_API_KEY=your-gfw-api-key

# Owner password of the AOI used in docs/verification snippets
# (must also appear in ACCESS_PASSWORDS)
AOI_OWNER_PWD=your-aoi-owner-password

# myACLED account for ACLED conflict-event API (OAuth password grant;
# ACLED retired static API keys in 2025). https://acleddata.com/register
ACLED_USERNAME=you@example.org
ACLED_PASSWORD=your-acled-password

# Protected Planet API token (https://api.protectedplanet.net/, free signup).
# Used by srv/protectedplanet, cmd/buildwdpaindex and scripts/onboard_park.py.
# NOTE: the token this replaced was a literal in those three files and is in
# the repo history -- treat that old value as public and rotate it upstream.
PROTECTEDPLANET_TOKEN=your-protectedplanet-token

# NASA Earthdata Login bearer token (urs.earthdata.nasa.gov -> Generate Token,
# ~60-day expiry). Used by scripts/fetch_nightlights.py (VNP46A3 Black Marble
# nightlights via LAADS DAAC). Absent => nightlight scripts skip, naming this var.
EARTHDATA_TOKEN=your-earthdata-bearer-token
