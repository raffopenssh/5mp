secrets.env

# Fire trajectory A/B eval snapshots (regenerate via eval_fire_trajectories.py)
# (glob the contents, not the dir: git cannot re-include a path under an
# excluded directory, and the nrt_sp results below must stay tracked)
data/eval/*
# ...except the NRT->SP drift measurements (28K): they are the evidence for a
# negative result documented in docs/FIRE_PIPELINE.md, and re-measuring each
# costs a FIRMS round-trip.
!data/eval/nrt_sp/
# ...and the mining-reference coverage measurements (13K): the evidence for the
# two findings in docs/agents/acled.md. They hold verdicts and summary
# statistics only -- no ACLED rows, so nothing here substitutes for ACLED's
# dataset. Everything else the ACLED pipeline writes is regenerable and stays
# out: data/eval/acled/ (per-ADM1 totals, 77K, 1 min from the xlsx),
# data/eval/adm1/ (geoBoundaries), data/eval/mining_reference.json (1.1 MB).
!data/eval/mining_reference_bias.json
!data/eval/reach_strata.json
# ...and the Crisis Tracker derivation (84K): 50 mine sites labelled once by a
# language model over the public display notes, plus the CAR reach verdict.
# Re-deriving it costs an LLM pass whose output would not be identical, so the
# labels are an artefact, not a cache. The raw pull that produced them is
# Invisible Children's data and stays out (see data/crisistracker/ below).
!data/eval/crisistracker/
# ...and the UCDP GED derivation (~160K): 96 mine sites labelled once by a
# language model over GED's location descriptions, same reasoning as Crisis
# Tracker above. The GED zip and candidate cache stay out (data/ucdp/ below).
!data/eval/ucdp/
# ...and the GSW new-water skill eval (2K): the WP4 stop-gate verdict
# (no signal at 0.035 power ceiling). The per-area candidate inventory is
# regenerable from the GSW tiles and stays out (data/gsw_new_water/ below).
!data/eval/gsw_new_water.json
data/viirs_backfill_state.json

# Mining analysis: bulk downloads & intermediate rasters (re-fetchable)
data/osm_geofabrik/
data/gsw/
# GSW new-water candidate inventory (WP4 rotation): regenerable from the
# tiles above, up to ~16 MB per area. Only the eval verdict is committed
# (data/eval/gsw_new_water.json, whitelisted above).
data/gsw_new_water/
analysis/out/*.png
analysis/out/*.npy

# Derived flow-accumulation percentile tiles (regenerate: analysis/flow_corridor.py)
data/flowacc/

# Basin geometries: DB (park_basins) is source of truth; JSON is a debug dump,
# and mghydro responses are cached in http_cache (scripts/fetch_park_basins.py)
data/park_basins/

# AMW (Amazon Mining Watch) evaluation: Sentinel-2 patch composite cache.
# Regenerable from STAC/GCS; keyed by lon/lat/date-window/patch geometry.
data/amw_cache/

# Derived fire pipeline output: rebuilt from fire_detections (canonical) by
# scripts/rebuild_fire_trajectories_v5.py. The 3-sensor v7 rebuild grew this
# from 131MB/181k groups to 762MB/711k groups, which does not belong in git.
data/fire_groups_v5/
data/fire_trends_v5/

# Monthly NRT->SP watchdog output (rewritten by daily_fire_update step 2e)
data/nrt_sp_audit.json

# Historical map rasters (derived, large) - regenerate with scripts/histmaps/runall.sh
# then scripts/histmaps/mosaic.sh. 669 MB of per-sheet GeoTIFFs + a 1.4 GB
# MBTiles mosaic + the per-block intermediates it is merged from.
data/histmaps/geo/
data/histmaps/superseded/
data/histmaps/work/
data/histmaps/*.mbtiles
data/histmaps/*.partial_tiles.db
data/histmaps/*.log
data/histmaps/*.jp2
# Stale snapshots of the scripts that the run copied next to its output; the
# live copies are in scripts/histmaps/. qa.json is NOT ignored -- it is the
# per-sheet quality record for the shipped mosaic and is small.
data/histmaps/*.py
scripts/histmaps/*.jp2
scripts/histmaps/qa.json
scripts/histmaps/*_geo.tif
scripts/histmaps/*_geo.tif.points
scripts/histmaps/__pycache__/

# GFW per-tile alert cache (regenerable; shared by park scans and AOI scans)
data/gfw_tiles/

# Pipeline heartbeats: rewritten by every cron run, served by /api/pipeline-status
# and the admin Access tab. State, not source — a commit of one is noise.
data/pipeline_status.json
data/aoi_status.json

# Rotated logs (5mp.logrotate -> /etc/logrotate.d/5mp)
logs/

# Mining scan scratch (the effort is retired — srv/mining_flag.go
# MiningEnabled = false; docs/MINING_FINDINGS_2026-08.md §10). Contact sheets,
# chips and per-run AUC dumps are reproducible from the eval scripts.
analysis/out/adjudicate/
analysis/out/tight/
analysis/out/truth1/
analysis/out/truth_eval.json

# Geology map overlays (scanned sources + derived rasters/vectors) - large,
# regenerate with scripts/geomaps/. See scripts/geomaps/README.md.
data/geomaps/src/
data/geomaps/work/
data/geomaps/*.mbtiles
data/geomaps/*.pmtiles
# vectorizer output: 34 MB for Sudan alone, regenerate with vectorize.py.
# legend_*.json IS committed - it is measured input, not derived output.
# <sheet>_classes.json IS committed too - it is the class catalogue the server
# reads (small, and the record of which merges the hold-out forced on a build).
data/geomaps/*_units.geojson
# Contact GEOMETRY is derived output (60 MB for Sudan); the geometry-free pair
# list beside it (<sheet>_contacts.json, ~30 KB) IS committed - the server
# reads it to build the catalogue. Rebuild both with scripts/geomaps/contacts.py.
data/geomaps/*_contacts.geojson
# built on first request from *_units.geojson (a cache, not an input).
# geology.gpkg is the current combined one; *_geology.gpkg was the per-sheet
# form and is still ignored so an old checkout's leftovers stay untracked.
data/geomaps/*_geology.gpkg
data/geomaps/geology.gpkg
data/geomaps/geology.gpkg.stamp

# GeoPackage export cache (derived, 21-day TTL, one directory per job)
data/gpkg_output/

# Historical-map fetch scratch: LOC contact thumbnails and rotated run logs
data/histmaps/thumbs/
data/histmaps/run_all.log.*

# ACLED's own aggregated data file: a cache of THEIR file, never committed
# (Content Usage Terms). Refresh with scripts/acled_download.py; the committed
# artefact is the derived scalars in data/eval/acled/.
data/acled/*.xlsx

# Crisis Tracker's own records: a cache of THEIR public map data, never
# committed. Refresh with scripts/crisistracker_fetch.py; the committed
# artefacts are the derived mine sites in data/eval/crisistracker/.
data/crisistracker/

# UCDP's own GED release: a cache of THEIR file (zip + filtered candidates
# with embedded source prose), never committed. Refresh with
# scripts/ucdp_fetch.py; committed artefacts are the derived labels/sites in
# data/eval/ucdp/.
data/ucdp/
data/nightlights/
data/histmaps/labels.sqlite3*
