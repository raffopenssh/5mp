.autofetch_key
backup-zenodo

# Local-only backups & raw downloads
backups/*.sql
data/worldclim/*.zip

# Local secrets (see secrets.env.example)
secrets.env

# Fire trajectory A/B eval snapshots (regenerate via eval_fire_trajectories.py)
# (glob the contents, not the dir: git cannot re-include a path under an
# excluded directory, and the nrt_sp results below must stay tracked)
data/eval/*
# ...except the NRT->SP drift measurements (28K): they are the evidence for a
# negative result documented in docs/FIRE_PIPELINE.md, and re-measuring each
# costs a FIRMS round-trip.
!data/eval/nrt_sp/
data/viirs_backfill_state.json

# Mining analysis: bulk downloads & intermediate rasters (re-fetchable)
data/osm_geofabrik/
data/gsw/
analysis/out/*.png
analysis/out/*.npy

# Derived flow-accumulation percentile tiles (regenerate: analysis/flow_corridor.py)
data/flowacc/

# Basin geometries: DB (park_basins) is source of truth; JSON is a debug dump,
# and mghydro responses are cached in http_cache (scripts/fetch_park_basins.py)
data/park_basins/

# AMW (Amazon Mining Watch) evaluation: Sentinel-2 patch composite cache.
# Regenerable from STAC/GCS; keyed by lon/lat/date-window/patch geometry.
data/amw_cache/

# Derived fire pipeline output: rebuilt from fire_detections (canonical) by
# scripts/rebuild_fire_trajectories_v5.py. The 3-sensor v7 rebuild grew this
# from 131MB/181k groups to 762MB/711k groups, which does not belong in git.
data/fire_groups_v5/
data/fire_trends_v5/

# Monthly NRT->SP watchdog output (rewritten by daily_fire_update step 2e)
data/nrt_sp_audit.json
